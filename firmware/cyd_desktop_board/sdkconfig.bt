# Bluetooth Classic HID host only (no BLE). Measured on the probe: BLE would
# cost about 17 KB more RAM and 270 KB more flash.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
# One keyboard, plus room for a second link while it reconnects.
CONFIG_BT_ACL_CONNECTIONS=2
# Needed by desktop_bt_memory to report task stack high-water marks.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# Measured unused: esp_timer 3.0 of 3.5 KB.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560
